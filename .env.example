# ==============================================================================
# Environment Configuration Template (.env)
# Rename this file to .env and configure your keys.
# ==============================================================================

# OpenRouter API Configuration for Signal 2 Substantive Compliance Auditor
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Automatic Failover Key (Used if Primary Key exceeds daily quota):
OPENROUTER_BACKUP_API_KEY=your_backup_openrouter_api_key_here

# Primary Model (Automatically cascades to Nemotron 3 Super 120B & Nemotron 3.5 Lightning if 503 overloaded):
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Google Gemini / Gemma API Configuration (Direct Failover Key for High-Quota RTI Judicial Reasoning)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
