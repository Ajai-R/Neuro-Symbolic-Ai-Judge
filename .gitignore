# ==============================================================================
# Git Ignore Rules for Neuro-Symbolic RTI Judicial Advisory System
# ==============================================================================

# 1. Environment Secrets & API Keys
.env
.env.local
.env.*.local
*.env
!.env.example

# 2. Datasets (Excluded per instructions; described in detail in README.md)
Dataset/
Final_dataset.csv
*.csv
*.jsonl
*.tsv
# Preserve training history and metric reports
!signal_1_inlegalbert/checkpoints/*.json
!decision_engine/*.json

# 3. Model Weights & Large Binary Checkpoints (> 100 MB)
*.safetensors
*.bin
*.pt
*.pth
*.onnx
signal_1_inlegalbert/checkpoints_8epoch_backup/
# Ensure tokenizer configs and architecture definitions are preserved
!signal_1_inlegalbert/checkpoints/best_model/config.json
!signal_1_inlegalbert/checkpoints/best_model/label_mapping.json
!signal_1_inlegalbert/checkpoints/best_model/tokenizer.json
!signal_1_inlegalbert/checkpoints/best_model/tokenizer_config.json

# 4. Frontend Dependencies & Build Output
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

# 5. Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
Fast_gpu/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/

# 6. Word, Presentation & Temporary Lock Files
~$*
*.docx
*.pptx
*.zip
extracted_template_media/
latex_figures_to_upload/

